{
  "languageserver": {
    "terraform": {
      "command": "terraform-lsp",
      "filetypes": [
        "terraform"
      ]
    },
    "go": {
      "command": "gopls",
      "rootPatterns": ["go.work", "go.mod", ".vim/", ".git/", ".hg/"],
      "filetypes": ["go"],
      "initializationOptions": {
        "usePlaceholders": true
      }
    }
  },
  "[go][json][sql]": {
    "coc.preferences.formatOnSave": true
  },
  "go.goplsOptions": {
    "staticcheck": true,
    "gofumpt": true
  }
}
